    {
      "name": "2. Cenário Resiliente (Rota Protegida)",
      "item": [
        {
          "name": "2.1 Fail-Fast (Item Negativo Bloqueado na Borda)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Empresa Gama Tech\",\n  \"integrationId\": \"PROT-FAILFAST-001\",\n  \"itens\": [\n    {\n      \"descricao\": \"Item Inválido\",\n      \"valor\": -100.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/protegido/ordens",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "protegido", "ordens"]
            },
            "description": "Retorna 400 Bad Request com Bean Validation antes de tocar na base de dados."
          }
        },
        {
          "name": "2.2 Atomicidade e Rollback (@Transactional)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Empresa Gama Tech\",\n  \"integrationId\": \"PROT-ROLLBACK-002\",\n  \"itens\": [\n    {\n      \"descricao\": \"Item Válido\",\n      \"valor\": 500.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/protegido/ordens?simularFalhaTransacao=true",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "protegido", "ordens"],
              "query": [
                {
                  "key": "simularFalhaTransacao",
                  "value": "true"
                }
              ]
            },
            "description": "Simula um erro durante a transação. O @Transactional faz rollback completo e nenhuma linha é gravada."
          }
        },
        {
          "name": "2.3 Idempotência - Disparo 1 (Criação)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Empresa Delta Log\",\n  \"integrationId\": \"PROT-IDEMPOTENCY-003\",\n  \"itens\": [\n    {\n      \"descricao\": \"Auditoria de Segurança\",\n      \"valor\": 2800.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/protegido/ordens",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "protegido", "ordens"]
            },
            "description": "Primeira requisição: grava a ordem com sucesso (201 Created)."
          }
        },
        {
          "name": "2.4 Idempotência - Disparo 2 (Retry Attack)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Empresa Delta Log\",\n  \"integrationId\": \"PROT-IDEMPOTENCY-003\",\n  \"itens\": [\n    {\n      \"descricao\": \"Auditoria de Segurança\",\n      \"valor\": 2800.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/protegido/ordens",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "protegido", "ordens"]
            },
            "description": "Segunda requisição: detecta o mesmo integration_id e retorna 200 OK sem criar duplicata."
          }
        }
      ]
    }
  ]
