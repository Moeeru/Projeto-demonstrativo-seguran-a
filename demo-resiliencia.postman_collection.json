    {
      "name": "1. Cenário Caótico (Rota Vulnerável)",
      "item": [
        {
          "name": "1.1 Partial Commit (Valor Negativo -> Gera Ordem Órfã)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Empresa Alfa Ltda\",\n  \"integrationId\": \"CAOS-PARTIAL-001\",\n  \"itens\": [\n    {\n      \"descricao\": \"Consultoria Técnica\",\n      \"valor\": 1500.00\n    },\n    {\n      \"descricao\": \"Item com Falha Injetada\",\n      \"valor\": -250.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/vulneravel/ordens",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "vulneravel", "ordens"]
            },
            "description": "Retorna 500 com Injeção de Falha. No banco, a ordem foi salva, mas o segundo item falhou. A ordem ficou órfã!"
          }
        },
        {
          "name": "1.2 Duplicidade - Disparo 1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Empresa Beta S/A\",\n  \"integrationId\": \"CAOS-RETRY-002\",\n  \"itens\": [\n    {\n      \"descricao\": \"Licença Mensal de Software\",\n      \"valor\": 350.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/vulneravel/ordens",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "vulneravel", "ordens"]
            }
          }
        },
        {
          "name": "1.3 Duplicidade - Disparo 2 (Mesmo integrationId)",
          "request": {
